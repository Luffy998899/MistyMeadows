# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).

# Safe to expose to the browser — protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER expose this. It bypasses row level security entirely.
# Required for: saving enquiries, sending email, and the SMTP settings screen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Needed when the app sits behind a proxy that rewrites the host — without
# it, Server Actions (every form in /admin) abort with "Invalid Server
# Actions request".
#
# List the ORIGIN the browser sends, not the proxy's hostname, and include
# the port if there is one. Comma-separated; "*" wildcards match a domain
# label, so they cannot match a port. Loopback and the usual dev tunnels are
# already allowed in development, so this is normally only for production.
# SERVER_ACTIONS_ALLOWED_ORIGINS=admin.example.com,*.preview.example.com
